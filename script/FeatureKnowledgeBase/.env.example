# FeatureCrawler never logs values whose keys look like secrets.
FEATURECRAWLER_LOG_LEVEL=INFO

# OpenAI-compatible semantic enrichment. Copy these names to a local .env file.
# The base URL must not include /chat/completions; the client appends it.
FEATURE_CRAWLER_LLM_API_KEY=
FEATURE_CRAWLER_LLM_BASE_URL=
FEATURE_CRAWLER_LLM_MODEL=
