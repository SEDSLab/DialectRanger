{"feature_id": "duckdb.datatype.timestamptz", "feature_type": "datatype", "dbms": "duckdb", "doc_version": "stable", "name": "TIMESTAMPTZ", "normalized_name": "timestamptz", "type_name": "TIMESTAMPTZ", "category": "", "signature": "timestamptz", "syntax": [{"pattern": "timestamptz", "evidence_refs": ["duckdb_stable_timestamp_s0002_b0008"]}], "aliases": [], "description_claims": [{"text": "Time zone aware timestamp with microsecond precision", "source": "rule", "confidence": 0.85, "evidence_refs": ["duckdb_stable_timestamp_s0002_b0008"]}, {"text": "The TIMESTAMPTZ type can be binned into calendar and clock bins using a suitable extension. The built-in ICU extension implements all the binning and arithmetic functions using the International Compo", "source": "rule", "confidence": 0.85, "evidence_refs": ["duckdb_stable_timestamp_s0002_b0008"]}, {"text": "Time binning operations for TIMESTAMPTZ will then be implemented using the given calendar. In this example, the era part will now report the Japanese imperial era number.", "source": "rule", "confidence": 0.85, "evidence_refs": ["duckdb_stable_timestamp_s0002_b0008"]}], "examples": [], "constraints": [], "attributes": {}, "source_sections": ["duckdb_stable_timestamp_s0002", "duckdb_stable_timestamp_s0003", "duckdb_stable_timestamp_s0009", "duckdb_stable_timestamp_s0010"], "source_anchors": [], "candidate_group_id": "duckdb.datatype.timestamptz", "status": "validated"}
